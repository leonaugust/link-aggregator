<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="create-user-communication-table" author="leonaugust">
    <createTable tableName="user_communication">
      <column name="user_id" type="uuid">
        <constraints primaryKey="true" primaryKeyName="pk_user_communication" nullable="false"/>
      </column>
      <column name="email" type="varchar(255)"/>
      <column name="telegram" type="varchar(255)"/>
      <column name="preferred_channel" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="language" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addForeignKeyConstraint
        baseTableName="user_communication"
        baseColumnNames="user_id"
        constraintName="fk_user_communication_user"
        referencedTableName="users"
        referencedColumnNames="id"/>
  </changeSet>

</databaseChangeLog>
